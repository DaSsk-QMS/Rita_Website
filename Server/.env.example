# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# --- Database ---
# MySQL / MariaDB (Hostinger: hPanel > Databases > Management). Tables are created automatically.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Or a single URL instead of the five values above: mysql://user:password@host:3306/dbname
DATABASE_URL=
# Optional folder for uploaded files (keep it outside the app folder so redeploys don't remove uploads)
UPLOAD_DIR=
# Set to true to run with a temporary in-memory database (dev/testing only, data is lost on restart)
USE_MEMORY_DB=false

# --- Auth ---
# Use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# First admin account (created automatically when the database has no users)
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@rita.local
ADMIN_PASSWORD=Admin@12345

# --- Email (SMTP) ---
# These are fallbacks. You can also set SMTP in Admin > Settings > Email (stored in DB, takes priority).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=RITA System Assurance
MAIL_FROM_EMAIL=
ADMIN_NOTIFY_EMAIL=
