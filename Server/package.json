{
  "name": "rita-website-server",
  "version": "1.0.0",
  "description": "RITA System Assurance website API (Express + MySQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "dev:memory": "cross-env USE_MEMORY_DB=true nodemon --watch src src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "sync-defaults": "node -e \"require('fs').copyFileSync('src/seed/defaults.js','../Frontend/src/data/defaults.js')\""
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.0",
    "sanitize-html": "^2.14.0",
    "slugify": "^1.6.6",
    "ua-parser-js": "^1.0.40",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9"
  }
}
